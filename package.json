{
  "name": "gx-soundboard-vban",
  "version": "1.0.0",
  "description": "Painel de Áudio Soundboard integrado ao VoiceMeeter VBAN",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.gx.soundboard",
    "productName": "GX Soundboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "config/**/*",
      "src/**/*",
      "audios/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "dependencies": {
    "audio-decode": "^3.12.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "voicemeeter-connector": "^2.2.0",
    "wav-decoder": "^1.3.0"
  }
}